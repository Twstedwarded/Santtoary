@page "/login"
@using Microsoft.AspNetCore.Components.Forms
@using Santtoary.Shared.DTOs
@inject NavigationManager Nav
@inject HttpClient Http

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-header">
            <div class="auth-mark">✦</div>
            <h1>Santtoary</h1>
            <p>Inicia sesión en tu cuenta</p>
        </div>

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="error-msg">@mensajeError</div>
            }

            <div class="input-group">
                <label>Email</label>
                <InputText class="input" @bind-Value="loginModel.Email" placeholder="correo@email.com" />
            </div>

            <div class="input-group">
                <label>Contraseña</label>
                <InputText type="password" class="input" @bind-Value="loginModel.Password" placeholder="••••••••" />
            </div>

            <button type="submit" class="auth-btn">Ingresar</button>
        </EditForm>

        <div class="auth-footer-link">
            ¿No tienes cuenta? <a href="/register">Crear cuenta</a>
        </div>

    </div>
</div>

@code {
    LoginDTO loginModel = new();
    private string? mensajeError;

    private async Task HandleLogin()
    {
        mensajeError = null;
        var response = await Http.PostAsJsonAsync("api/users/login", loginModel);
        if (response.IsSuccessStatusCode)
            Nav.NavigateTo("/panel");
        else
            mensajeError = "Usuario o contraseña incorrectos.";
    }
}

<style>
    .auth-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #0a0a0a;
        background-image: radial-gradient(ellipse at center, #1a1200 0%, #0a0a0a 70%);
        font-family: 'Raleway', sans-serif;
    }

    .auth-card {
        width: 400px;
        background: #111;
        border: 1px solid #1e1e1e;
        padding: 3rem 2.5rem;
        border-radius: 8px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    }

    .auth-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .auth-mark {
        color: #c9a84c;
        font-size: 1.2rem;
        margin-bottom: 0.75rem;
        opacity: 0.6;
        letter-spacing: 0.5em;
    }

    .auth-header h1 {
        font-family: 'Cinzel', serif;
        font-size: 1.8rem;
        color: #c9a84c;
        margin: 0 0 0.5rem;
        letter-spacing: 0.15em;
        font-weight: 700;
    }

    .auth-header p {
        color: #444;
        font-size: 0.85rem;
        margin: 0;
        letter-spacing: 0.03em;
    }

    .error-msg {
        background: #1a0a0a;
        border: 1px solid #7a1a1a44;
        color: #ef5350;
        padding: 0.75rem 1rem;
        border-radius: 4px;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
        text-align: center;
    }

    .input-group {
        margin-bottom: 1.25rem;
    }

    .input-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-size: 0.8rem;
        font-weight: 600;
        color: #555;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .input {
        width: 100%;
        padding: 0.85rem 1rem;
        border: 1px solid #222;
        border-radius: 4px;
        background: #0d0d0d;
        color: #e0e0e0;
        font-size: 0.9rem;
        font-family: 'Raleway', sans-serif;
        outline: none;
        transition: border-color 0.2s ease;
        box-sizing: border-box;
    }

    .input:focus {
        border-color: #c9a84c;
        box-shadow: 0 0 0 2px rgba(201, 168, 76, 0.1);
    }

    .input::placeholder {
        color: #333;
    }

    .auth-btn {
        width: 100%;
        padding: 0.9rem;
        border: none;
        border-radius: 4px;
        background: #c9a84c;
        color: #0a0a0a;
        font-family: 'Raleway', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: 0.5rem;
    }

    .auth-btn:hover {
        background: #e8c96e;
    }

    .auth-btn:focus,
    .auth-btn:active {
        outline: none;
        box-shadow: none;
    }

    .auth-footer-link {
        margin-top: 1.5rem;
        text-align: center;
        color: #444;
        font-size: 0.85rem;
    }

    .auth-footer-link a {
        color: #c9a84c;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s ease;
    }

    .auth-footer-link a:hover {
        color: #e8c96e;
    }
</style>