@page "/login"
@layout EmptyLayout
@using Microsoft.AspNetCore.Components.Forms
@using Santtoary.Shared.DTOs
@inject NavigationManager Nav
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JSRuntime

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-header">
            <div class="auth-mark">✦</div>
            <h1>Santtoary</h1>
            <p>Inicia sesión en tu cuenta</p>
        </div>

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="error-msg">@mensajeError</div>
            }

            <div class="input-group">
                <label>Email</label>
                <InputText class="input" @bind-Value="loginModel.Email" placeholder="correo@email.com" />
            </div>

            <div class="input-group">
                <label>Contraseña</label>
                <InputText type="password" class="input" @bind-Value="loginModel.Password" placeholder="••••••••" />
            </div>

            <button type="submit" class="auth-btn">Ingresar</button>
        </EditForm>

        <div class="auth-footer-link">
            ¿No tienes cuenta? <a href="/register">Crear cuenta</a>
        </div>

        <div class="register-link" style="margin-top: 15px; text-align: center;">
            <a href="/ResendToken">Reenviar correo de activación</a>
        </div>

    </div>
</div>

@code {
    LoginDTO loginModel = new();
    private string? mensajeError;

    private async Task HandleLogin()
    {
        mensajeError = null;

        try
        {
            var Http = ClientFactory.CreateClient("Santtoary.API");
            var response = await Http.PostAsJsonAsync("api/users/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                var token = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "authToken", token);
                Nav.NavigateTo("/panel");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                mensajeError = string.IsNullOrEmpty(errorContent) ? "Usuario o contraseña incorrectos." : errorContent;
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error de conexión: " + ex.Message;
        }
    }
}

