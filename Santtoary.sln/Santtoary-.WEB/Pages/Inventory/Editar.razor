@page "/inventario/editar/{Id:int}"
@inject IRepository repository
@inject NavigationManager Nav

<h3>Editar Insumo</h3>

@if (item == null)
{
    <p>Cargando...</p>
}
else
{
    <EditForm Model="item" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Nombre del insumo *</label>
            <InputText class="form-control" @bind-Value="item.Name" />
            <ValidationMessage For="@(() => item.Name)" />
        </div>

        <div class="mb-3">
            <label>Cantidad *</label>
            <InputNumber class="form-control" @bind-Value="item.Quantity" />
            <ValidationMessage For="@(() => item.Quantity)" />
        </div>

        <div class="mb-3">
            <label>Stock Mínimo</label>
            <InputNumber class="form-control" @bind-Value="item.MinimumStockLevel" />
        </div>

        <button type="submit" class="btn btn-success">Guardar cambios</button>
        <a href="/inventario" class="btn btn-secondary ms-2">Cancelar</a>
    </EditForm>
}

@if (mensaje != null)
{
    <div class="alert alert-danger">@mensaje</div>
}

@code {
    [Parameter] public int Id { get; set; }
    private InventoryItem? item;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        var result = await repository.GetAsync<InventoryItem>($"api/inventoryitems/{Id}");
        item = result.Response;
    }

    async Task Guardar()
    {
        var result = await repository.PutAsync($"api/inventoryitems/{Id}", item);
        if (result.Error)
        {
            mensaje = await result.GetErrorMessageAsync();
        }
        else
        {
            Nav.NavigateTo("/inventario");
        }
    }
}