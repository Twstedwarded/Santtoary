@page "/inventario/crear"
@inject IRepository repository
@inject NavigationManager Nav

<h3>Nuevo Insumo</h3>

<EditForm Model="item" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Nombre del insumo *</label>
        <InputText class="form-control" @bind-Value="item.Name" />
        <ValidationMessage For="@(() => item.Name)" />
    </div>

    <div class="mb-3">
        <label>Cantidad *</label>
        <InputNumber class="form-control" @bind-Value="item.Quantity" />
        <ValidationMessage For="@(() => item.Quantity)" />
    </div>

    <div class="mb-3">
        <label>Stock Mínimo</label>
        <InputNumber class="form-control" @bind-Value="item.MinimumStockLevel" />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a href="/inventario" class="btn btn-secondary ms-2">Cancelar</a>
</EditForm>

@if (mensaje != null)
{
    <div class="alert alert-danger">@mensaje</div>
}

@code {
    private InventoryItem item = new();
    private string? mensaje;

    async Task Guardar()
    {
        var result = await repository.PostAsync("api/inventoryitems", item);
        if (result.Error)
        {
            mensaje = await result.GetErrorMessageAsync();
        }
        else
        {
            Nav.NavigateTo("/inventario");
        }
    }
}