@page "/api/Users/ConfirmEmail"
@layout EmptyLayout
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-header">
            <div class="auth-mark">✦</div>
            <h1>Santtoary</h1>
            <p>Confirmación de cuenta</p>
        </div>

        <p class="auth-text">
            Estás a un paso de activar tu cuenta. Presiona el botón para confirmar tu correo electrónico.
        </p>

        <button class="auth-btn" @onclick="ConfirmAccountAsync">
            Confirmar Cuenta
        </button>

    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "userid")]
    public string UserId { get; set; } = "";

    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string Token { get; set; } = "";

    protected async Task ConfirmAccountAsync()
    {
        var response = await Http.GetAsync($"api/users/ConfirmEmail?userId={UserId}&token={Token}");

        if (response.IsSuccessStatusCode)
        {
            await JS.InvokeVoidAsync("alert", "¡Gracias por confirmar tu email! Ahora puedes ingresar al sistema.");
            Nav.NavigateTo("/login");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Hubo un problema: {error}");
            Nav.NavigateTo("/login");
        }
    }
}

<style>
    .auth-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #0a0a0a;
        background-image: radial-gradient(ellipse at center, #1a1200 0%, #0a0a0a 70%);
        font-family: 'Raleway', sans-serif;
    }

    .auth-card {
        width: 400px;
        background: #111;
        border: 1px solid #222;
        padding: 3rem 2.5rem;
        border-radius: 8px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
        text-align: center;
    }

    .auth-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .auth-mark {
        color: #c9a84c;
        font-size: 1.2rem;
        margin-bottom: 0.75rem;
        opacity: 0.8;
        letter-spacing: 0.5em;
    }

    .auth-header h1 {
        font-family: 'Cinzel', serif;
        font-size: 1.8rem;
        color: #c9a84c;
        margin: 0 0 0.5rem;
        letter-spacing: 0.15em;
        font-weight: 700;
    }

    .auth-header p {
        color: #b3b3b3;
        font-size: 0.9rem;
        margin: 0;
        letter-spacing: 0.03em;
    }

    .auth-text {
        color: #e0e0e0;
        font-size: 0.95rem;
        margin-bottom: 2rem;
        line-height: 1.6;
    }

    .auth-btn {
        width: 100%;
        padding: 0.9rem;
        border: none;
        border-radius: 4px;
        background: #c9a84c;
        color: #0a0a0a;
        font-family: 'Raleway', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .auth-btn:hover {
            background: #e8c96e;
            box-shadow: 0 5px 15px rgba(201, 168, 76, 0.3);
        }
</style>