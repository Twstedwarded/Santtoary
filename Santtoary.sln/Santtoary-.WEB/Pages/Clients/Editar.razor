@page "/clientes/editar/{Id:int}"
@inject IRepository repository
@inject NavigationManager Nav

<h3>Editar Cliente</h3>

@if (cliente == null)
{
    <p>Cargando...</p>
}
else
{
    <EditForm Model="cliente" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Nombre *</label>
            <InputText class="form-control" @bind-Value="cliente.Name" />
            <ValidationMessage For="@(() => cliente.Name)" />
        </div>

        <div class="mb-3">
            <label>Documento *</label>
            <InputText class="form-control" @bind-Value="cliente.Document" />
            <ValidationMessage For="@(() => cliente.Document)" />
        </div>

        <div class="mb-3">
            <label>Teléfono</label>
            <InputText class="form-control" @bind-Value="cliente.Phone" />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <InputText class="form-control" @bind-Value="cliente.Email" />
            <ValidationMessage For="@(() => cliente.Email)" />
        </div>

        <div class="mb-3">
            <label>Notas Médicas</label>
            <InputTextArea class="form-control" @bind-Value="cliente.MedicalNotes" rows="3" />
        </div>

        <button type="submit" class="btn btn-success">Guardar cambios</button>
        <a href="/clientes" class="btn btn-secondary ms-2">Cancelar</a>
    </EditForm>
}

@if (mensaje != null)
{
    <div class="alert alert-danger">@mensaje</div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Client? cliente;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        var result = await repository.GetAsync<Client>($"api/clients/{Id}");
        cliente = result.Response;
    }

    async Task Guardar()
    {
        var result = await repository.PutAsync($"api/clients/{Id}", cliente);
        if (result.Error)
        {
            mensaje = await result.GetErrorMessageAsync();
        }
        else
        {
            Nav.NavigateTo("/clientes");
        }
    }
}  