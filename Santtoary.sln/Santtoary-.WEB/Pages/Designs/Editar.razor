@page "/disenos/editar/{Id:int}"
@inject IRepository repository
@inject NavigationManager Nav

<h3>Editar Diseño</h3>

@if (diseno == null)
{
    <p>Cargando...</p>
}
else
{
    <EditForm Model="diseno" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Título *</label>
            <InputText class="form-control" @bind-Value="diseno.Title" />
            <ValidationMessage For="@(() => diseno.Title)" />
        </div>

        <div class="mb-3">
            <label>URL de imagen</label>
            <InputText class="form-control" @bind-Value="diseno.ImageUrl" />
        </div>

        <div class="mb-3">
            <label>Precio *</label>
            <InputNumber class="form-control" @bind-Value="diseno.Price" />
            <ValidationMessage For="@(() => diseno.Price)" />
        </div>

        <div class="mb-3">
            <label>Artista *</label>
            <InputSelect class="form-control" @bind-Value="diseno.ArtistId">
                <option value="">-- Seleccione un artista --</option>
                @foreach (var artista in artistas)
                {
                    <option value="@artista.Id">@artista.Name</option>
                }
            </InputSelect>
        </div>

        <button type="submit" class="btn btn-success">Guardar cambios</button>
        <a href="/disenos" class="btn btn-secondary ms-2">Cancelar</a>
    </EditForm>
}

@if (mensaje != null)
{
    <div class="alert alert-danger">@mensaje</div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Design? diseno;
    private List<Artist> artistas = new();
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        var resultDiseno = await repository.GetAsync<Design>($"api/designs/{Id}");
        diseno = resultDiseno.Response;
        var resultArtistas = await repository.GetAsync<List<Artist>>("api/artists");
        artistas = resultArtistas.Response ?? new();
    }

    async Task Guardar()
    {
        var result = await repository.PutAsync($"api/designs/{Id}", diseno);
        if (result.Error)
        {
            mensaje = await result.GetErrorMessageAsync();
        }
        else
        {
            Nav.NavigateTo("/disenos");
        }
    }
}