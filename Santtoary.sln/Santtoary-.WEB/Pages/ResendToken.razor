    }

    .auth-card {
        width: 400px;
        background: #111;
        border: 1px solid #222;
        padding: 3rem 2.5rem;
        border-radius: 8px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
    }

    .auth-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .auth-mark {
        color: #c9a84c;
        font-size: 1.2rem;
        margin-bottom: 0.75rem;
        opacity: 0.8;
        letter-spacing: 0.5em;
    }

    .auth-header h1 {
        font-family: 'Cinzel', serif;
        font-size: 1.8rem;
        color: #c9a84c;
        margin: 0 0 0.5rem;
        letter-spacing: 0.15em;
        font-weight: 700;
    }

    .auth-header p {
        color: #b3b3b3;
        font-size: 0.9rem;
        margin: 0;
        letter-spacing: 0.03em;
    }

    .error-msg {
        background: #1a0a0a;
        border: 1px solid #ef5350;
        color: #ff8a80;
        padding: 0.75rem 1rem;
        border-radius: 4px;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
        text-align: center;
    }

    .input-group {
        margin-bottom: 1.25rem;
    }

        .input-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 0.8rem;
            font-weight: 600;
            color: #c9a84c;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

    .input {
        width: 100%;
        padding: 0.85rem 1rem;
        border: 1px solid #333;
        border-radius: 4px;
        background: #0d0d0d;
        color: #fff;
        font-size: 0.9rem;
        outline: none;
        transition: border-color 0.2s ease;
    }

        .input:focus {
            border-color: #c9a84c;
            box-shadow: 0 0 0 2px rgba(201, 168, 76, 0.2);
        }

    .auth-btn {
        width: 100%;
        padding: 0.9rem;
        border: none;
        border-radius: 4px;
        background: #c9a84c;
        color: #0a0a0a;
        font-family: 'Raleway', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: 0.5rem;
    }

        .auth-btn:hover {
            background: #e8c96e;
        }

    .auth-footer-link {
        margin-top: 1.5rem;
        text-align: center;
        color: #b3b3b3;
        font-size: 0.85rem;
    }

        .auth-footer-link a {
            color: #c9a84c;
            text-decoration: none;
            font-weight: 600;
        }
</style> 