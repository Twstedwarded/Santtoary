@page "/ResendToken"
@layout EmptyLayout
@using Microsoft.AspNetCore.Components.Forms
@using Santtoary.Shared.DTOs
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-header">
            <div class="auth-mark">✦</div>
            <h1>Santtoary</h1>
            <p>Reenviar correo de confirmación</p>
        </div>

        <EditForm Model="@emailDTO" OnValidSubmit="ResendEmailAsync">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="error-msg">@mensajeError</div>
            }

            <div class="input-group">
                <label>Email</label>
                <InputText class="input"
                           @bind-Value="emailDTO.Email"
                           placeholder="correo@email.com" />
                <ValidationMessage For="@(() => emailDTO.Email)" />
            </div>

            <button type="submit" class="auth-btn">
                Reenviar Correo
            </button>
        </EditForm>

        <div class="auth-footer-link">
            <a href="/login">Volver al Login</a>
        </div>

    </div>
</div>

@code {
    private EmailDTO emailDTO = new();
    private string? mensajeError;

    private async Task ResendEmailAsync()
    {
        mensajeError = null;

        var response = await Http.PostAsJsonAsync("api/users/ResedToken", emailDTO);

        if (response.IsSuccessStatusCode)
        {
            await JS.InvokeVoidAsync("alert", "Se te ha enviado un correo electrónico con las instrucciones para activar tu usuario.");
            Nav.NavigateTo("/login");
        }
        else
        {
            mensajeError = "No pudimos enviar el correo. Verifica que el email sea correcto o que no estés ya habilitado.";
        }
    }
}

<style>
    .auth-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #0a0a0a;
